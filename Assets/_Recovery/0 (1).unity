  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 \u0E40\u0E27\u0E25\u0E32\u0E04\u0E37\u0E2D\u0E0A\u0E35\u0E27\u0E34\u0E15:
    \u0E40\u0E23\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E1A\u0E38\u0E04\u0E04\u0E25\u0E18\u0E23\u0E23\u0E21\u0E14\u0E32
    \u0E15\u0E31\u0E49\u0E07\u0E41\u0E15\u0E48 1 \u0E21\u0E01\u0E23\u0E32\u0E04\u0E21
    - 31 \u0E21\u0E35\u0E19\u0E32\u0E04\u0E21 \u0E02\u0E2D\u0E07\u0E17\u0E38\u0E01\u0E1B\u0E35
    (\u0E16\u0E49\u0E32\u0E22\u0E37\u0E48\u0E19\u0E2D\u0E2D\u0E19\u0E44\u0E25\u0E19\u0E4C\u0E44\u0E14\u0E49\u0E16\u0E36\u0E07
    8 \u0E40\u0E21\u0E29\u0E32\u0E22\u0E19)\n\n\u2022 \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E04\u0E31\u0E21\u0E20\u0E35\u0E23\u0E4C
    (\u0E41\u0E1A\u0E1A\u0E1F\u0E2D\u0E23\u0E4C\u0E21) \u0E43\u0E2B\u0E49\u0E16\u0E39\u0E01:\n\t\u2022
    \u0E20.\u0E07.\u0E14. 91: \u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E04\u0E19\u0E21\u0E35
    \"\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\" \t\t\t\t\u0E40\u0E1E\u0E35\u0E22\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27
    (40(1)) -> \u0E08\u0E33\u0E07\u0E48\u0E32\u0E22\u0E46 \"91 \t\t\t\u0E21\u0E35
    1\u0E41\u0E2B\u0E25\u0E48\u0E07\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\"\n\t\u2022
    \u0E20.\u0E07.\u0E14. 90: \u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E04\u0E19\u0E17\u0E35\u0E48\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49
    \"\u0E2D\u0E37\u0E48\u0E19\u0E46\" \n\t\u0E2B\u0E23\u0E37\u0E2D \"\u0E2B\u0E25\u0E32\u0E22\u0E17\u0E32\u0E07\"
    (\u0E40\u0E0A\u0E48\u0E19 \u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19
    + \u0E02\u0E32\u0E22\u0E02\u0E2D\u0E07, \t\t\u0E2B\u0E23\u0E37\u0E2D \u0E1F\u0E23\u0E35\u0E41\u0E25\u0E19\u0E0B\u0E4C\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27)
    -> \u0E08\u0E33\u0E07\u0E48\u0E32\u0E22\u0E46 \"90 \t\t\t\u0E04\u0E37\u0E2D \u0E01\u0E25\u0E21\u0E46
    \u0E23\u0E27\u0E21\u0E46 \u0E01\u0E31\u0E19\u0E21\u0E32\""
  m_isRightToLeft: 0
