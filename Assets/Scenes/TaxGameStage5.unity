    isChoicePage: 0
  - dialogueText: "\u0E15\u0E34\u0E4A\u0E01... \u0E15\u0E48\u0E2D\u0E01... \u0E15\u0E34\u0E4A\u0E01...
      \u0E15\u0E48\u0E2D\u0E01... \u0E0A\u0E49\u0E32\u0E08\u0E23\u0E34\u0E07\u0E40\u0E0A\u0E35\u0E22\u0E27!
      \u0E02\u0E49\u0E32\u0E0A\u0E2D\u0E1A\u0E40\u0E27\u0E25\u0E32\u0E17\u0E35\u0E48\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E25\u0E19\u0E25\u0E32\u0E19\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E44\u0E21\u0E48\u0E17\u0E31\u0E19 "
    speakerName: "\u0E08\u0E2D\u0E21\u0E21\u0E32\u0E23"
    background: {fileID: -1675273491431618826, guid: 9a9a4ac6a0a864f62b26d4d3f4b46795, type: 3}
    speechBubble: {fileID: -3577410830333116246, guid: 07a2f4f693d024cf7b5556e9e450e381, type: 3}
    characterLeft: {fileID: 0}
    characterCenter: {fileID: -1127933441503263673, guid: 562bff66c52fa4b28878ec5cc5464d59, type: 3}
    characterRight: {fileID: 0}
    isChoicePage: 0
  - dialogueText: "\u0E1E\u0E27\u0E01\u0E40\u0E08\u0E49\u0E32\u0E23\u0E39\u0E49\u0E44\u0E2B\u0E21\u0E27\u0E48\u0E32\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E38\u0E02\u0E02\u0E2D\u0E07\u0E02\u0E49\u0E32\u0E04\u0E37\u0E2D\u0E2D\u0E30\u0E44\u0E23?
      \u0E04\u0E37\u0E2D\u0E01\u0E32\u0E23\u0E40\u0E2B\u0E47\u0E19\u0E1E\u0E27\u0E01\u0E40\u0E08\u0E49\u0E32\u0E25\u0E37\u0E21\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35
      \u0E41\u0E25\u0E49\u0E27\u0E42\u0E14\u0E19 '\u0E04\u0E48\u0E32\u0E1B\u0E23\u0E31\u0E1A'
      (Fine) \u0E41\u0E25\u0E30 '\u0E40\u0E07\u0E34\u0E19\u0E40\u0E1E\u0E34\u0E48\u0E21'
      (Surcharge) \u0E01\u0E34\u0E19\u0E08\u0E19\u0E2B\u0E21\u0E14\u0E15\u0E31\u0E27\u0E44\u0E07\u0E25\u0E48\u0E30!
      \u0E2E\u0E48\u0E32\u0E46\u0E46!"
    speakerName: "\u0E08\u0E2D\u0E21\u0E21\u0E32\u0E23"
