  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " \u2022 \u0E40\u0E01\u0E23\u0E32\u0E30\u0E1E\u0E37\u0E49\u0E19\u0E10\u0E32\u0E19
    (\u0E04\u0E48\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E2A\u0E48\u0E27\u0E19\u0E15\u0E31\u0E27):
    \u0E17\u0E31\u0E19\u0E17\u0E35\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35
    \u0E23\u0E31\u0E10\u0E21\u0E2D\u0E1A\u0E40\u0E01\u0E23\u0E32\u0E30\u0E19\u0E35\u0E49\u0E43\u0E2B\u0E49\u0E17\u0E38\u0E01\u0E04\u0E19!
    \u0E25\u0E14\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E44\u0E1B\u0E40\u0E25\u0E22
    60,000 \u0E1A\u0E32\u0E17\n \n\u2022 \u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E23\u0E32\u0E07\u0E1B\u0E23\u0E30\u0E01\u0E31\u0E19\u0E2A\u0E31\u0E07\u0E04\u0E21:
    \u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E17\u0E38\u0E01\u0E04\u0E19\u0E16\u0E39\u0E01\u0E2B\u0E31\u0E01\u0E40\u0E07\u0E34\u0E19\u0E40\u0E02\u0E49\u0E32\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E19\u0E35\u0E49
    (\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E25\u0E30
    750 \u0E1A\u0E32\u0E17) \u0E40\u0E2D\u0E32\u0E21\u0E32\u0E22\u0E37\u0E48\u0E19\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E44\u0E14\u0E49\u0E15\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07
    \u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14\u0E44\u0E21\u0E48\u0E40\u0E01\u0E34\u0E19
    9,000 \u0E1A\u0E32\u0E17/\u0E1B\u0E35\n\n \u2022 \u0E42\u0E25\u0E48\u0E04\u0E23\u0E2D\u0E1A\u0E04\u0E23\u0E31\u0E27:
    \u0E40\u0E25\u0E35\u0E49\u0E22\u0E07\u0E14\u0E39\u0E1E\u0E48\u0E2D\u0E41\u0E21\u0E48
    (\u0E04\u0E19\u0E25\u0E30 30,000), \u0E04\u0E39\u0E48\u0E2A\u0E21\u0E23\u0E2A,
    \u0E2B\u0E23\u0E37\u0E2D\u0E25\u0E39\u0E01 \u0E01\u0E47\u0E40\u0E2D\u0E32\u0E21\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E44\u0E14\u0E49\u0E2D\u0E35\u0E01!"
  m_isRightToLeft: 0
