--- !u!114 &1602382759
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1602382758}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aee31984464764cb48d67f3db2140d7c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examlogic
  maxheart: 3
  playercurrentheart: 3
  enemycurrentheart: 3
  allquestions:
  - questionText: "\u0E02\u0E49\u0E32\u0E08\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E08\u0E32\u0E01\u0E17\u0E48\u0E32\u0E1E\u0E37\u0E49\u0E19\u0E10\u0E32\u0E19!
      \u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E17\u0E38\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35
      \u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E41\u0E19\u0E48\u0E40\u0E2B\u0E23\u0E2D?
      \u0E23\u0E31\u0E10\u0E1A\u0E32\u0E25\u0E43\u0E2B\u0E49\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C
      '\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E2A\u0E48\u0E27\u0E19\u0E15\u0E31\u0E27'
      \u0E41\u0E01\u0E48\u0E1C\u0E39\u0E49\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35\u0E17\u0E38\u0E01\u0E04\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E08\u0E33\u0E19\u0E27\u0E19\u0E40\u0E17\u0E48\u0E32\u0E44\u0E2B\u0E23\u0E48!"
    type: 0
    choices:
    - "60,000 \u0E1A\u0E32\u0E17"
    - "30,000 \u0E1A\u0E32\u0E17"
    - "100,000 \u0E1A\u0E32\u0E17"
    - "\u0E15\u0E32\u0E21\u0E08\u0E33\u0E19\u0E27\u0E19\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A"
    correctChoiceIndex: 0
    correctStringAnswer: 
  - questionText: "\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E1E\u0E27\u0E01\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19
      (40(1)) \u0E1E\u0E27\u0E01\u0E40\u0E08\u0E49\u0E32\u0E42\u0E14\u0E19\u0E2B\u0E31\u0E01\u0E40\u0E07\u0E34\u0E19\u0E17\u0E38\u0E01\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E40\u0E02\u0E49\u0E32\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E2B\u0E19\u0E36\u0E48\u0E07
      \u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E19\u0E31\u0E49\u0E19\u0E40\u0E2D\u0E32\u0E21\u0E32\u0E43\u0E0A\u0E49\u0E40\u0E1B\u0E47\u0E19
      '\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E23\u0E32\u0E07' \u0E01\u0E31\u0E19\u0E02\u0E49\u0E32\u0E44\u0E14\u0E49...
      \u0E21\u0E31\u0E19\u0E04\u0E37\u0E2D\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E2D\u0E30\u0E44\u0E23!?"
    type: 0
    choices:
    - "\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E40\u0E07\u0E34\u0E19\u0E17\u0E14\u0E41\u0E17\u0E19"
    - "\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E19\u0E49\u0E33\u0E21\u0E31\u0E19\u0E40\u0E0A\u0E37\u0E49\u0E2D\u0E40\u0E1E\u0E25\u0E34\u0E07"
    - "\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E1B\u0E23\u0E30\u0E01\u0E31\u0E19\u0E2A\u0E31\u0E07\u0E04\u0E21"
    - "\u0E01\u0E2D\u0E07\u0E17\u0E38\u0E19\u0E2B\u0E21\u0E39\u0E48\u0E1A\u0E49\u0E32\u0E19"
    correctChoiceIndex: 2
    correctStringAnswer: 
  - questionText: "\u0E16\u0E49\u0E32\u0E40\u0E08\u0E49\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E08\u0E48\u0E32\u0E22\u0E1B\u0E23\u0E30\u0E01\u0E31\u0E19\u0E2A\u0E31\u0E07\u0E04\u0E21\u0E40\u0E15\u0E47\u0E21\u0E41\u0E21\u0E47\u0E01\u0E0B\u0E4C
      (750 \u0E1A\u0E32\u0E17/\u0E40\u0E14\u0E37\u0E2D\u0E19) \u0E15\u0E25\u0E2D\u0E14\u0E17\u0E31\u0E49\u0E07\u0E1B\u0E35...
      \u0E40\u0E08\u0E49\u0E32\u0E08\u0E30\u0E43\u0E0A\u0E49\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E20\u0E32\u0E29\u0E35\u0E08\u0E32\u0E01\u0E1B\u0E23\u0E30\u0E01\u0E31\u0E19\u0E2A\u0E31\u0E07\u0E04\u0E21\u0E44\u0E14\u0E49\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14\u0E01\u0E35\u0E48\u0E1A\u0E32\u0E17!
      \u0E15\u0E2D\u0E1A\u0E02\u0E49\u0E32\u0E21\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E31\u0E27\u0E40\u0E25\u0E02!"
    type: 1
    choices: []
    correctChoiceIndex: 0
    correctStringAnswer: 9000
