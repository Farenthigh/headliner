    isChoicePage: 0
  - dialogueText: "\u0E0A\u0E48\u0E27\u0E22\u0E14\u0E49\u0E27\u0E22\u0E1C\u0E39\u0E49\u0E01\u0E25\u0E49\u0E32!
      \u0E21\u0E31\u0E19\u0E2A\u0E32\u0E1B\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E02\u0E22\u0E31\u0E1A\u0E15\u0E31\u0E27\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49
      \u0E21\u0E31\u0E19\u0E08\u0E30\u0E22\u0E36\u0E14\u0E2D\u0E32\u0E13\u0E32\u0E08\u0E31\u0E01\u0E23\u0E19\u0E35\u0E49\u0E14\u0E49\u0E27\u0E22\u0E14\u0E2D\u0E01\u0E40\u0E1A\u0E35\u0E49\u0E22\u0E04\u0E48\u0E32\u0E1B\u0E23\u0E31\u0E1A!"
    speakerName: "\u0E1E\u0E23\u0E30\u0E23\u0E32\u0E0A\u0E32"
    background: {fileID: -1675273491431618826, guid: 9a9a4ac6a0a864f62b26d4d3f4b46795, type: 3}
