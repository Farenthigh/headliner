      \u0E21\u0E31\u0E19\u0E04\u0E37\u0E2D\u0E41\u0E27\u0E21\u0E44\u0E1E\u0E23\u0E4C\u0E20\u0E32\u0E29\u0E35!
      \u0E21\u0E31\u0E19\u0E0A\u0E2D\u0E1A\u0E14\u0E39\u0E14\u0E40\u0E07\u0E34\u0E19\u0E08\u0E32\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E15\u0E31\u0E27
      \u0E04\u0E19\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E43\u0E0A\u0E49
      '\u0E04\u0E48\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19' \u0E01\u0E47\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E40\u0E14\u0E34\u0E19\u0E15\u0E31\u0E27\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E43\u0E2B\u0E49\u0E21\u0E31\u0E19\u0E01\u0E31\u0E14\u0E04\u0E2D\u0E40\u0E25\u0E48\u0E19\u0E19\u0E31\u0E48\u0E19\u0E41\u0E2B\u0E25\u0E30!"
    speakerName: '{Name}'
    speakerPosition: 2
    background: {fileID: 4349194590612477393, guid: bcbf939e575ee4d7ea99ddfdf4f843f1, type: 3}
    speechBubble: {fileID: -3577410830333116246, guid: 07a2f4f693d024cf7b5556e9e450e381, type: 3}
    characterLeft: {fileID: 0}
    characterCenter: {fileID: 4354231566380549168, guid: 0d2f6708399ba4ae0aec337df1665387, type: 3}
    characterRight: {fileID: 0}
    isChoicePage: 0
    isNamingPage: 0
  - dialogueText: "\u0E1F\u0E38\u0E14\u0E1F\u0E34\u0E14... \u0E01\u0E25\u0E34\u0E48\u0E19\u0E40\u0E07\u0E34\u0E19\u0E2A\u0E14\u0E2B\u0E2D\u0E21\u0E2B\u0E27\u0E32\u0E19!
      \u0E1E\u0E27\u0E01\u0E40\u0E08\u0E49\u0E32\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49
      \u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E04\u0E48\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21?
      \u0E21\u0E32\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E14\u0E39\u0E14\u0E20\u0E32\u0E29\u0E35\u0E0B\u0E30\u0E14\u0E35\u0E46!"
    speakerName: "\u0E41\u0E27\u0E21\u0E44\u0E1E\u0E23\u0E4C\u0E20\u0E32\u0E29\u0E35"
    speakerPosition: 2
    background: {fileID: 4349194590612477393, guid: bcbf939e575ee4d7ea99ddfdf4f843f1, type: 3}
    speechBubble: {fileID: -3577410830333116246, guid: 07a2f4f693d024cf7b5556e9e450e381, type: 3}
    characterLeft: {fileID: 0}
    characterCenter: {fileID: 5913643589360538641, guid: d5aa271de76fb45cea5d1b49313cc73d, type: 3}
    characterRight: {fileID: 0}
    isChoicePage: 0
    isNamingPage: 0
  - dialogueText: "\u0E17\u0E48\u0E32\u0E19\u0E1C\u0E39\u0E49\u0E01\u0E25\u0E49\u0E32!
      \u0E2D\u0E22\u0E48\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E07\u0E2A\u0E39\u0E49\u0E21\u0E37\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32!
      \u0E40\u0E23\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E2A\u0E27\u0E21\u0E40\u0E01\u0E23\u0E32\u0E30\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E01\u0E48\u0E2D\u0E19
      \u0E08\u0E33\u0E04\u0E32\u0E16\u0E32\u0E1A\u0E17\u0E19\u0E35\u0E49\u0E44\u0E27\u0E49\u0E19\u0E30!"
    speakerName: '{Name}'
    speakerPosition: 2
    background: {fileID: 4349194590612477393, guid: bcbf939e575ee4d7ea99ddfdf4f843f1, type: 3}
    speechBubble: {fileID: -3577410830333116246, guid: 07a2f4f693d024cf7b5556e9e450e381, type: 3}
    characterLeft: {fileID: 0}
    characterCenter: {fileID: 410971064699957904, guid: cb518a63800d74fe0be4629d645d587e, type: 3}
    characterRight: {fileID: 0}
    isChoicePage: 0
    isNamingPage: 0
  - dialogueText: 
    speakerName: 
    speakerPosition: 0
    background: {fileID: 4349194590612477393, guid: bcbf939e575ee4d7ea99ddfdf4f843f1, type: 3}
    speechBubble: {fileID: 0}
    characterLeft: {fileID: 0}
    characterCenter: {fileID: 0}
    characterRight: {fileID: 0}
    isChoicePage: 0
    isNamingPage: 0
  - dialogueText: "\u0E40\u0E01\u0E23\u0E32\u0E30\u0E40\u0E01\u0E2D\u0E30\u0E2D\u0E30\u0E44\u0E23\u0E44\u0E23\u0E49\u0E2A\u0E32\u0E23\u0E30!
      \u0E02\u0E49\u0E32\u0E08\u0E30\u0E01\u0E31\u0E14\u0E04\u0E2D\u0E40\u0E08\u0E49\u0E32\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E19\u0E35\u0E49\u0E41\u0E2B\u0E25\u0E30!"
    speakerName: "\u0E41\u0E27\u0E21\u0E44\u0E1E\u0E23\u0E4C\u0E20\u0E32\u0E29\u0E35"
    speakerPosition: 2
    background: {fileID: 4349194590612477393, guid: bcbf939e575ee4d7ea99ddfdf4f843f1, type: 3}
