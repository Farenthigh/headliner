  m_Script: {fileID: 11500000, guid: 1029fdb8256f94e05a4c005169b9f5c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialPanel: {fileID: 827744808}
  tutorialText: {fileID: 1460519620}
  highlightCircle: {fileID: 1522710796}
  Character: {fileID: 1315707647}
  typingSpeed: 0.05
  bobbingAmount: 0.02
  bobbingSpeed: 3
  steps:
  - message: "\u0E22\u0E34\u0E19\u0E14\u0E35\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A\u0E2A\u0E39\u0E48\u0E40\u0E01\u0E32\u0E30\u0E41\u0E2B\u0E48\u0E07\u0E01\u0E32\u0E23\u0E2D\u0E2D\u0E21!
      \u0E09\u0E31\u0E19\u0E08\u0E30\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E2B\u0E49\u0E04\u0E38\u0E13\u0E16\u0E36\u0E07\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22\u0E40\u0E2D\u0E07"
    target: {fileID: 0}
  - message: "\u0E40\u0E23\u0E34\u0E48\u0E21\u0E08\u0E32\u0E01\u0E17\u0E35\u0E48
      \u0E1A\u0E49\u0E32\u0E19 \u0E2B\u0E25\u0E31\u0E07\u0E19\u0E35\u0E49 \u0E04\u0E38\u0E13\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E40\u0E0A\u0E47\u0E04\u0E22\u0E2D\u0E14\u0E40\u0E07\u0E34\u0E19\u0E41\u0E25\u0E30\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22\u0E44\u0E14\u0E49\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48"
    target: {fileID: 1683252961}
  - message: "\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23\u0E41\u0E15\u0E48\u0E25\u0E30\u0E41\u0E2B\u0E48\u0E07\u0E08\u0E30\u0E21\u0E35\u0E14\u0E2D\u0E01\u0E40\u0E1A\u0E35\u0E49\u0E22\u0E15\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19\u0E19\u0E30
      \u0E25\u0E2D\u0E07\u0E01\u0E14\u0E14\u0E39\u0E23\u0E32\u0E22\u0E25\u0E30\u0E40\u0E2D\u0E35\u0E22\u0E14\u0E02\u0E2D\u0E07\u0E41\u0E15\u0E48\u0E25\u0E30\u0E17\u0E35\u0E48\u0E2A\u0E34"
    target: {fileID: 311653197}
  - message: "\u0E2A\u0E48\u0E27\u0E19\u0E1A\u0E49\u0E32\u0E19\u0E2B\u0E25\u0E31\u0E07\u0E40\u0E25\u0E47\u0E01\u0E17\u0E32\u0E07\u0E19\u0E35\u0E49\u0E04\u0E37\u0E2D
      \u0E01\u0E23\u0E30\u0E1B\u0E38\u0E01\u0E2D\u0E2D\u0E21\u0E40\u0E07\u0E34\u0E19
      \u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E40\u0E01\u0E47\u0E1A\u0E40\u0E07\u0E34\u0E19\u0E40\u0E25\u0E47\u0E01\u0E46
      \u0E19\u0E49\u0E2D\u0E22\u0E46"
    target: {fileID: 146037428}
  - message: "\u0E23\u0E30\u0E27\u0E31\u0E07\u0E19\u0E30! \u0E04\u0E38\u0E13\u0E21\u0E35\u0E40\u0E27\u0E25\u0E32\u0E08\u0E33\u0E01\u0E31\u0E14\u0E41\u0E04\u0E48
      12 \u0E40\u0E14\u0E37\u0E2D\u0E19\u0E43\u0E19\u0E01\u0E32\u0E23\u0E40\u0E01\u0E47\u0E1A\u0E40\u0E07\u0E34\u0E19\u0E43\u0E2B\u0E49\u0E04\u0E23\u0E1A\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22"
    target: {fileID: 0}
  - message: "\"\u0E16\u0E49\u0E32\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E41\u0E25\u0E49\u0E27...
      \u0E40\u0E23\u0E34\u0E48\u0E21\u0E2D\u0E2D\u0E21\u0E40\u0E07\u0E34\u0E19\u0E01\u0E31\u0E19\u0E40\u0E25\u0E22!\""
    target: {fileID: 0}
  animSpeed: 0.4
