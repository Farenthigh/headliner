  - dialogueText: "\u0E02\u0E49\u0E32\u0E17\u0E33\u0E07\u0E32\u0E19\u0E17\u0E38\u0E01\u0E27\u0E31\u0E19
      \u0E2A\u0E34\u0E49\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E02\u0E49\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E44\u0E14\u0E49\u0E40\u0E07\u0E34\u0E19\u0E40\u0E15\u0E47\u0E21\u0E2A\u0E34!"
    speakerName: "\u0E41\u0E14\u0E07"
