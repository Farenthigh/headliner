--- !u!114 &531727793
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 531727792}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aee31984464764cb48d67f3db2140d7c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examlogic
  maxheart: 3
  playercurrentheart: 3
  enemycurrentheart: 3
  allquestions:
  - questionText: "\u0E01\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E40\u0E08\u0E49\u0E32\u0E08\u0E30\u0E23\u0E39\u0E49\u0E27\u0E48\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E2A\u0E35\u0E22\u0E20\u0E32\u0E29\u0E35\u0E01\u0E35\u0E48\u0E1A\u0E32\u0E17
      \u0E40\u0E08\u0E49\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E2B\u0E32 '\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34'
      \u0E43\u0E2B\u0E49\u0E40\u0E08\u0E2D\u0E01\u0E48\u0E2D\u0E19... \u0E08\u0E07\u0E1A\u0E2D\u0E01\u0E2A\u0E21\u0E01\u0E32\u0E23\u0E17\u0E35\u0E48\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07\u0E21\u0E32!"
    type: 0
    choices:
    - "\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49 - \u0E20\u0E32\u0E29\u0E35\u0E21\u0E39\u0E25\u0E04\u0E48\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E21
      = \u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34"
    - "\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49 + \u0E42\u0E1A\u0E19\u0E31\u0E2A = \u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34"
    - "\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49 - \u0E04\u0E48\u0E32\u0E43\u0E0A\u0E49\u0E08\u0E48\u0E32\u0E22
      - \u0E04\u0E48\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19 = \u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34"
    - "\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49 x 7% = \u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34"
    correctChoiceIndex: 2
    correctStringAnswer: 
  - questionText: "\u0E23\u0E30\u0E1A\u0E1A\u0E1B\u0E23\u0E30\u0E21\u0E27\u0E25\u0E1C\u0E25\u0E15\u0E48\u0E2D...
      \u0E1B\u0E23\u0E30\u0E40\u0E17\u0E28\u0E19\u0E35\u0E49\u0E43\u0E0A\u0E49\u0E2D\u0E31\u0E15\u0E23\u0E32\u0E20\u0E32\u0E29\u0E35\u0E41\u0E1A\u0E1A
      '\u0E01\u0E49\u0E32\u0E27\u0E2B\u0E19\u0E49\u0E32' (Progressive Rate) \u0E22\u0E34\u0E48\u0E07\u0E23\u0E27\u0E22\u0E22\u0E34\u0E48\u0E07\u0E08\u0E48\u0E32\u0E22\u0E40\u0E22\u0E2D\u0E30...
      \u0E41\u0E15\u0E48\u0E23\u0E31\u0E10\u0E1A\u0E32\u0E25\u0E43\u0E08\u0E14\u0E35
      \u0E22\u0E01\u0E40\u0E27\u0E49\u0E19\u0E20\u0E32\u0E29\u0E35\u0E43\u0E2B\u0E49\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E01\u0E49\u0E32\u0E27\u0E41\u0E23\u0E01
      \u0E0A\u0E48\u0E27\u0E07\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34\u0E40\u0E17\u0E48\u0E32\u0E44\u0E2B\u0E23\u0E48
      \u0E17\u0E35\u0E48\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E22\u0E01\u0E40\u0E27\u0E49\u0E19\u0E20\u0E32\u0E29\u0E35
      (\u0E40\u0E2A\u0E35\u0E22 0%)?"
    type: 0
    choices:
    - "\_0 - 100,000 \u0E1A\u0E32\u0E17"
    - "0 - 300,000 \u0E1A\u0E32\u0E17"
    - "0 - 500,000 \u0E1A\u0E32\u0E17"
    - "0 - 150,000 \u0E1A\u0E32\u0E17"
    correctChoiceIndex: 3
    correctStringAnswer: 
  - questionText: "\u0E2B\u0E36\u0E46\u2026 \u0E40\u0E08\u0E49\u0E32\u0E1A\u0E2D\u0E01\u0E27\u0E48\u0E32\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E40\u0E22\u0E2D\u0E30\u0E41\u0E25\u0E49\u0E27\u0E08\u0E30\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E2A\u0E35\u0E22\u0E20\u0E32\u0E29\u0E35\u0E40\u0E2A\u0E21\u0E2D\u0E2A\u0E34\u0E19\u0E30!?
      \u0E16\u0E49\u0E32\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49 500,000
      \u0E41\u0E15\u0E48\u0E2B\u0E31\u0E01\u0E08\u0E19\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34
      140,000\u2026 \u0E02\u0E49\u0E32\u0E08\u0E30\u0E40\u0E01\u0E47\u0E1A\u0E20\u0E32\u0E29\u0E35\u0E40\u0E08\u0E49\u0E32\u0E44\u0E14\u0E49\u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E21\u0E48!?"
    type: 0
    choices:
    - "\u0E44\u0E14\u0E49! \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E2A\u0E39\u0E07"
    - "\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49! \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E14\u0E39\u0E17\u0E35\u0E48\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34"
    - "\u0E44\u0E14\u0E49! \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E40\u0E01\u0E34\u0E19
      150,000 \u0E15\u0E31\u0E49\u0E07\u0E41\u0E15\u0E48\u0E41\u0E23\u0E01"
    - "\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49! \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E21\u0E35\u0E04\u0E48\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19"
    correctChoiceIndex: 1
    correctStringAnswer: 0
  - questionText: "\u0E2E\u0E48\u0E32\u0E46! \u0E16\u0E49\u0E32\u0E40\u0E08\u0E49\u0E32\u0E21\u0E35\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34
      120,001 \u0E1A\u0E32\u0E17\u2026 \u0E41\u0E1B\u0E25\u0E27\u0E48\u0E32\u0E40\u0E08\u0E49\u0E32
      \u201C\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35\u201D
      \u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21\u0E25\u0E48\u0E30!?"
    type: 0
    choices:
    - "\u0E43\u0E0A\u0E48 \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19"
    - "\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48! \u0E2D\u0E32\u0E08\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19
      \u0E41\u0E15\u0E48\u0E20\u0E32\u0E29\u0E35 = 0"
    - "\u0E43\u0E0A\u0E48 \u0E40\u0E1E\u0E23\u0E32\u0E30\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E19\u0E49\u0E2D\u0E22"
    - "\u0E44\u0E21\u0E48\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E01\u0E31\u0E19\u0E40\u0E25\u0E22"
    correctChoiceIndex: 1
    correctStringAnswer: 0
  - questionText: "\u0E1A\u0E17\u0E17\u0E14\u0E2A\u0E2D\u0E1A\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22...
      \u0E04\u0E33\u0E19\u0E27\u0E13\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E19\u0E35\u0E49!
      \u0E2A\u0E21\u0E21\u0E15\u0E34\u0E40\u0E08\u0E49\u0E32\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E23\u0E27\u0E21
      300,000 \u0E1A\u0E32\u0E17... \u0E2B\u0E31\u0E01\u0E04\u0E48\u0E32\u0E43\u0E0A\u0E49\u0E08\u0E48\u0E32\u0E22\u0E41\u0E25\u0E30\u0E04\u0E48\u0E32\u0E25\u0E14\u0E2B\u0E22\u0E48\u0E2D\u0E19\u0E15\u0E48\u0E32\u0E07\u0E46
      \u0E44\u0E1B\u0E2B\u0E21\u0E14\u0E41\u0E25\u0E49\u0E27 \u0E40\u0E2B\u0E25\u0E37\u0E2D
      '\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E2A\u0E38\u0E17\u0E18\u0E34'
      \u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48 140,000 \u0E1A\u0E32\u0E17 \u0E40\u0E08\u0E49\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E08\u0E48\u0E32\u0E22\u0E20\u0E32\u0E29\u0E35\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E01\u0E35\u0E48\u0E1A\u0E32\u0E17?"
    type: 1
