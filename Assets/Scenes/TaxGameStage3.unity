  - dialogueText: 
    speakerName: 
    speakerPosition: 0
    background: {fileID: 8685835791614800407, guid: f9290858f68d94cdea805b7410bf3031, type: 3}
    speechBubble: {fileID: 0}
    characterLeft: {fileID: 0}
