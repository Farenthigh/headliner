  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u202240(1) \u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19:
    \u0E21\u0E35\u0E19\u0E32\u0E22\u0E08\u0E49\u0E32\u0E07 \u0E08\u0E48\u0E32\u0E22\u0E40\u0E17\u0E48\u0E32\u0E01\u0E31\u0E19\u0E17\u0E38\u0E01\u0E40\u0E14\u0E37\u0E2D\u0E19
    \u0E21\u0E35\u0E2A\u0E25\u0E34\u0E1B\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19
    (Salary)\n\n\u202240(2) \u0E1F\u0E23\u0E35\u0E41\u0E25\u0E19\u0E0B\u0E4C/\u0E23\u0E31\u0E1A\u0E08\u0E49\u0E32\u0E07:
    \u0E23\u0E31\u0E1A\u0E17\u0E33\u0E07\u0E32\u0E19\u0E43\u0E2B\u0E49\u0E2A\u0E33\u0E40\u0E23\u0E47\u0E08\u0E40\u0E1B\u0E47\u0E19\u0E0A\u0E34\u0E49\u0E19\u0E46
    \u0E43\u0E0A\u0E49\u0E41\u0E23\u0E07+\u0E2A\u0E21\u0E2D\u0E07 \u0E41\u0E25\u0E01\u0E40\u0E07\u0E34\u0E19
    (\u0E40\u0E0A\u0E48\u0E19 \u0E04\u0E48\u0E32\u0E04\u0E2D\u0E21\u0E21\u0E34\u0E0A\u0E0A\u0E31\u0E19,
    \u0E23\u0E31\u0E1A\u0E08\u0E49\u0E32\u0E07\u0E40\u0E02\u0E35\u0E22\u0E19\u0E41\u0E1A\u0E1A)\n\n\u202240(8)
    \u0E18\u0E38\u0E23\u0E01\u0E34\u0E08/\u0E02\u0E32\u0E22\u0E02\u0E2D\u0E07: \u0E0B\u0E37\u0E49\u0E2D\u0E21\u0E32\u0E02\u0E32\u0E22\u0E44\u0E1B,
    \u0E40\u0E1B\u0E34\u0E14\u0E23\u0E49\u0E32\u0E19\u0E2D\u0E32\u0E2B\u0E32\u0E23,
    \u0E02\u0E32\u0E22\u0E2D\u0E2D\u0E19\u0E44\u0E25\u0E19\u0E4C (\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E2D\u0E37\u0E48\u0E19\u0E46
    \u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E40\u0E02\u0E49\u0E32\u0E1E\u0E27\u0E01
    1-7)"
