  m_Script: {fileID: 11500000, guid: aee31984464764cb48d67f3db2140d7c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examlogic
  questionPanel: {fileID: 2076555986}
  choicePanel: {fileID: 1837208091}
  inputPanel: {fileID: 1731108072}
  questionTextUI: {fileID: 129233559}
  choiceButtons:
  - {fileID: 1696064423}
  - {fileID: 2044256160}
  - {fileID: 1954716806}
  - {fileID: 1579882232}
  choicebuttontextUI:
  - {fileID: 425597600}
  - {fileID: 1914222663}
  - {fileID: 1595234359}
  - {fileID: 1970411858}
  answerInputField: {fileID: 1373539186}
  resultTextUI: {fileID: 0}
  allquestions:
  - questionText: "\u0E02\u0E49\u0E32\u0E08\u0E30\u0E40\u0E01\u0E47\u0E1A\u0E40\u0E07\u0E34\u0E19\u0E0A\u0E32\u0E27\u0E1A\u0E49\u0E32\u0E19\u0E40\u0E1E\u0E34\u0E48\u0E21!
      \u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E40\u0E1E\u0E34\u0E48\u0E07\u0E0B\u0E37\u0E49\u0E2D\u0E14\u0E32\u0E1A\u0E21\u0E32
      100 \u0E40\u0E2B\u0E23\u0E35\u0E22\u0E0D \u0E02\u0E49\u0E32\u0E08\u0E30\u0E40\u0E01\u0E47\u0E1A\u0E2D\u0E35\u0E01
      7 \u0E40\u0E2B\u0E23\u0E35\u0E22\u0E0D \u0E40\u0E1B\u0E47\u0E19\u0E04\u0E48\u0E32\u0E20\u0E32\u0E29\u0E35\u0E21\u0E39\u0E25\u0E04\u0E48\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E21
      (VAT) \u0E40\u0E02\u0E49\u0E32\u0E01\u0E23\u0E30\u0E40\u0E1B\u0E4B\u0E32\u0E02\u0E49\u0E32\u0E40\u0E2D\u0E07
      \u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07\u0E44\u0E2B\u0E21\u0E27\u0E30!?"
    type: 0
    choices:
    - "\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07! \u0E40\u0E01\u0E47\u0E1A\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E2D\u0E35\u0E01
      7% \u0E41\u0E22\u0E01\u0E15\u0E48\u0E32\u0E07\u0E2B\u0E32\u0E01\u0E40\u0E25\u0E22"
    - "\u0E1C\u0E34\u0E14! \u0E23\u0E32\u0E04\u0E32\u0E2A\u0E48\u0E27\u0E19\u0E43\u0E2B\u0E0D\u0E48\u0E23\u0E27\u0E21
      VAT 7% \u0E41\u0E25\u0E49\u0E27 \u0E2B\u0E49\u0E32\u0E21\u0E40\u0E01\u0E47\u0E1A\u0E0B\u0E49\u0E33!"
    - "\u0E1C\u0E34\u0E14! \u0E14\u0E32\u0E1A\u0E40\u0E1B\u0E47\u0E19\u0E2D\u0E32\u0E27\u0E38\u0E18
      \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E2A\u0E35\u0E22\u0E20\u0E32\u0E29\u0E35"
    - "\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07! \u0E41\u0E15\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E01\u0E47\u0E1A
      10% \u0E19\u0E30"
    correctChoiceIndex: 1
    correctStringAnswer: 
    correctMessage: "\u0E40\u0E08\u0E49\u0E32\u0E1C\u0E34\u0E14 \u0E23\u0E32\u0E04\u0E32\u0E21\u0E31\u0E19\u0E23\u0E27\u0E21
      VAT \u0E41\u0E25\u0E49\u0E27!"
    correctMessageSide: 0
    wrongMessage: "\u0E42\u0E07\u0E48\u0E08\u0E23\u0E34\u0E07\u0E46! \u0E08\u0E48\u0E32\u0E22\u0E21\u0E32\u0E0B\u0E30\u0E14\u0E35\u0E46"
    wrongMessageSide: 1
  - questionText: "\u0E07\u0E31\u0E49\u0E19\u0E02\u0E49\u0E32\u0E16\u0E32\u0E21\u0E2B\u0E19\u0E48\u0E2D\u0E22
      \u0E17\u0E33\u0E44\u0E21\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E2A\u0E35\u0E22\u0E20\u0E32\u0E29\u0E35\u0E43\u0E2B\u0E49\u0E27\u0E38\u0E48\u0E19\u0E27\u0E32\u0E22\u0E14\u0E49\u0E27\u0E22?
      \u0E40\u0E01\u0E47\u0E1A\u0E44\u0E27\u0E49\u0E01\u0E34\u0E19\u0E40\u0E2D\u0E07\u0E44\u0E21\u0E48\u0E14\u0E35\u0E01\u0E27\u0E48\u0E32\u0E23\u0E36\u0E44\u0E07?"
    type: 0
    choices:
    - "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E43\u0E2B\u0E49\u0E02\u0E38\u0E19\u0E19\u0E32\u0E07\u0E21\u0E35\u0E40\u0E07\u0E34\u0E19\u0E43\u0E0A\u0E49\u0E1F\u0E38\u0E48\u0E21\u0E40\u0E1F\u0E37\u0E2D\u0E22"
    - "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E47\u0E19\u0E01\u0E32\u0E23\u0E25\u0E07\u0E42\u0E17\u0E29\u0E04\u0E19\u0E23\u0E27\u0E22"
    - "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E33\u0E40\u0E07\u0E34\u0E19\u0E44\u0E1B\u0E1E\u0E31\u0E12\u0E19\u0E32\u0E1B\u0E23\u0E30\u0E40\u0E17\u0E28
      \u0E2A\u0E23\u0E49\u0E32\u0E07\u0E2A\u0E32\u0E18\u0E32\u0E23\u0E13\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C"
    - "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E33\u0E40\u0E07\u0E34\u0E19\u0E44\u0E1B\u0E1D\u0E32\u0E01\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23\u0E43\u0E2B\u0E49\u0E14\u0E2D\u0E01\u0E40\u0E1A\u0E35\u0E49\u0E22\u0E07\u0E2D\u0E01\u0E40\u0E07\u0E22"
    correctChoiceIndex: 2
    correctStringAnswer: 
    correctMessage: "\u0E20\u0E32\u0E29\u0E35\u0E04\u0E37\u0E2D\u0E2B\u0E19\u0E49\u0E32\u0E17\u0E35\u0E48!"
    correctMessageSide: 0
    wrongMessage: "\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E43\u0E0A\u0E49\u0E22\u0E31\u0E07\u0E08\u0E30\u0E14\u0E35\u0E0B\u0E30\u0E01\u0E27\u0E48\u0E32"
    wrongMessageSide: 1
  - questionText: "\u0E2B\u0E36\u0E46\u2026 \u0E16\u0E49\u0E32\u0E40\u0E14\u0E47\u0E01\u0E19\u0E49\u0E2D\u0E22\u0E0B\u0E37\u0E49\u0E2D\u0E02\u0E2D\u0E07\u0E43\u0E19\u0E15\u0E25\u0E32\u0E14
      \u0E02\u0E49\u0E32\u0E04\u0E07\u0E40\u0E01\u0E47\u0E1A VAT \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2A\u0E34\u0E19\u0E30?
      \u0E40\u0E14\u0E47\u0E01\u0E21\u0E31\u0E19\u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E19\u0E35\u0E48\u0E19\u0E32!"
    type: 0
    choices:
    - "\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07! \u0E40\u0E14\u0E47\u0E01\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E08\u0E48\u0E32\u0E22
      VAT"
    - "\u0E1C\u0E34\u0E14! \u0E17\u0E38\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E0B\u0E37\u0E49\u0E2D\u0E02\u0E2D\u0E07\u0E01\u0E47\u0E08\u0E48\u0E32\u0E22
      VAT \u0E2D\u0E22\u0E39\u0E48\u0E14\u0E35"
    - "\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07! \u0E40\u0E01\u0E47\u0E1A\u0E44\u0E14\u0E49\u0E40\u0E09\u0E1E\u0E32\u0E30\u0E04\u0E19\u0E17\u0E33\u0E07\u0E32\u0E19"
    - "\u0E1C\u0E34\u0E14! \u0E40\u0E01\u0E47\u0E1A VAT \u0E40\u0E09\u0E1E\u0E32\u0E30\u0E1C\u0E39\u0E49\u0E43\u0E2B\u0E0D\u0E48\u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19"
    correctChoiceIndex: 1
    correctStringAnswer: 
    correctMessage: "\u0E40\u0E08\u0E49\u0E32\u0E19\u0E35\u0E48\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E2A\u0E35\u0E22\u0E41\u0E25\u0E49\u0E27"
    correctMessageSide: 0
    wrongMessage: "\u0E40\u0E08\u0E49\u0E32\u0E21\u0E31\u0E19\u0E42\u0E07\u0E48"
    wrongMessageSide: 1
  - questionText: "\u0E2D\u0E37\u0E21\u2026 \u0E16\u0E49\u0E32\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49
      150,000 \u0E1A\u0E32\u0E17\u0E15\u0E48\u0E2D\u0E1B\u0E35 \u0E02\u0E49\u0E32\u0E08\u0E30\u0E2A\u0E31\u0E48\u0E07\u0E43\u0E2B\u0E49\u0E21\u0E31\u0E19
      \u201C\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35\u201D
      \u0E44\u0E14\u0E49\u0E44\u0E2B\u0E21\u0E19\u0E30? \u0E02\u0E49\u0E32\u0E02\u0E35\u0E49\u0E40\u0E01\u0E35\u0E22\u0E08\u0E14\u0E39\u0E40\u0E2D\u0E01\u0E2A\u0E32\u0E23
      \u0E2E\u0E48\u0E32\u0E46!"
    type: 0
    choices:
    - "\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49! \u0E40\u0E09\u0E1E\u0E32\u0E30\u0E04\u0E19\u0E23\u0E27\u0E22\u0E21\u0E32\u0E01\u0E46
      \u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19\u0E17\u0E35\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19"
    - "\u0E44\u0E14\u0E49! \u0E16\u0E49\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E42\u0E2A\u0E14\u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19"
    - "\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49! \u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E40\u0E01\u0E34\u0E19
      120,000 \u0E1A\u0E32\u0E17/\u0E1B\u0E35 \u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35 "
    - "\u0E44\u0E14\u0E49! \u0E08\u0E30\u0E22\u0E37\u0E48\u0E19\u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E21\u0E48\u0E01\u0E47\u0E44\u0E14\u0E49"
    correctChoiceIndex: 2
    correctStringAnswer: 
    correctMessage: "\u0E40\u0E08\u0E2D\u0E19\u0E35\u0E48\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E44\u0E07"
    correctMessageSide: 0
    wrongMessage: "\u0E40\u0E08\u0E49\u0E32\u0E1E\u0E25\u0E32\u0E14\u0E41\u0E25\u0E49\u0E27"
    wrongMessageSide: 1
  - questionText: "\u0E2B\u0E36! \u0E07\u0E31\u0E49\u0E19\u0E02\u0E49\u0E32\u0E08\u0E30\u0E2A\u0E32\u0E1B\u0E43\u0E2B\u0E49\u0E17\u0E38\u0E01\u0E04\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35\u0E43\u0E2B\u0E49\u0E2B\u0E21\u0E14!\n\u0E08\u0E07\u0E23\u0E30\u0E1A\u0E38
      \u201C\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E02\u0E31\u0E49\u0E19\u0E15\u0E48\u0E33\u0E15\u0E48\u0E2D\u0E1B\u0E35\u201D
      \u0E02\u0E2D\u0E07\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E42\u0E2A\u0E14
      (\u0E15\u0E2D\u0E1A\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E31\u0E27\u0E40\u0E25\u0E02
      \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E2A\u0E48\u0E25\u0E39\u0E01\u0E19\u0E49\u0E33)"
    type: 1
    choices: []
    correctChoiceIndex: 0
    correctStringAnswer: 120000
    correctMessage: "\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E02\u0E49\u0E32\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E2B\u0E23\u0E37\u0E2D"
    correctMessageSide: 0
    wrongMessage: "\u0E2E\u0E48\u0E32\u0E46\u0E46\u0E46"
    wrongMessageSide: 1
