  allquestions:
  - questionText: "\u0E02\u0E49\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E17\u0E2B\u0E32\u0E23\u0E22\u0E32\u0E21\u0E40\u0E1D\u0E49\u0E32\u0E40\u0E21\u0E37\u0E2D\u0E07
