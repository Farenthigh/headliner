  m_Script: {fileID: 11500000, guid: aee31984464764cb48d67f3db2140d7c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Examlogic
  maxheart: 3
  playercurrentheart: 3
  enemycurrentheart: 3
  allquestions:
  - questionText: "\u0E02\u0E49\u0E32\u0E08\u0E30\u0E2A\u0E32\u0E1B\u0E43\u0E2B\u0E49\u0E40\u0E08\u0E49\u0E32\u0E25\u0E37\u0E21\u0E27\u0E31\u0E19\u0E04\u0E37\u0E19!
      ...\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E2B\u0E19\u0E49\u0E32\u0E42\u0E07\u0E48\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E1E\u0E27\u0E01\u0E40\u0E08\u0E49\u0E32
      \u0E08\u0E30\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E1A\u0E38\u0E04\u0E04\u0E25\u0E18\u0E23\u0E23\u0E21\u0E14\u0E32
      \u0E20\u0E32\u0E22\u0E43\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E44\u0E2B\u0E19
      \u0E16\u0E36\u0E07\u0E08\u0E30\u0E1B\u0E25\u0E2D\u0E14\u0E20\u0E31\u0E22\u0E08\u0E32\u0E01\u0E04\u0E48\u0E32\u0E1B\u0E23\u0E31\u0E1A\u0E02\u0E2D\u0E07\u0E02\u0E49\u0E32?"
    type: 0
    choices:
    - "\u0E20\u0E32\u0E22\u0E43\u0E19\u0E2A\u0E34\u0E49\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E18\u0E31\u0E19\u0E27\u0E32\u0E04\u0E21
      \u0E02\u0E2D\u0E07\u0E1B\u0E35\u0E17\u0E35\u0E48\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49"
    - "\u0E20\u0E32\u0E22\u0E43\u0E19\u0E2A\u0E34\u0E49\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E21\u0E35\u0E19\u0E32\u0E04\u0E21
      \u0E02\u0E2D\u0E07\u0E1B\u0E35\u0E16\u0E31\u0E14\u0E44\u0E1B"
    - "\u0E20\u0E32\u0E22\u0E43\u0E19\u0E2A\u0E34\u0E49\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19\u0E22\u0E32\u0E22\u0E19
      \u0E02\u0E2D\u0E07\u0E1B\u0E35\u0E16\u0E31\u0E14\u0E44\u0E1B"
    - "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E44\u0E2B\u0E23\u0E48\u0E01\u0E47\u0E44\u0E14\u0E49\u0E17\u0E35\u0E48\u0E40\u0E08\u0E49\u0E32\u0E2D\u0E22\u0E32\u0E01\u0E08\u0E48\u0E32\u0E22"
    correctChoiceIndex: 1
    correctStringAnswer: 
  - questionText: "\u0E07\u0E31\u0E49\u0E19\u0E21\u0E32\u0E14\u0E39\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E41\u0E1A\u0E1A\u0E1F\u0E2D\u0E23\u0E4C\u0E21\u0E1A\u0E49\u0E32\u0E07!
      \u0E02\u0E49\u0E32\u0E21\u0E35\u0E2A\u0E21\u0E38\u0E19\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19
      '\u0E1E\u0E48\u0E2D\u0E04\u0E49\u0E32\u0E02\u0E32\u0E22\u0E02\u0E2D\u0E07\u0E2D\u0E2D\u0E19\u0E44\u0E25\u0E19\u0E4C'
      \u0E41\u0E25\u0E30 '\u0E1F\u0E23\u0E35\u0E41\u0E25\u0E19\u0E0B\u0E4C'... \u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E0B\u0E31\u0E1A\u0E0B\u0E49\u0E2D\u0E19\u0E22\u0E38\u0E48\u0E07\u0E40\u0E2B\u0E22\u0E34\u0E07
      \u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49\u0E2D\u0E32\u0E27\u0E38\u0E18
      (\u0E41\u0E1A\u0E1A\u0E1F\u0E2D\u0E23\u0E4C\u0E21) \u0E0A\u0E19\u0E34\u0E14\u0E44\u0E2B\u0E19\u0E21\u0E32\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35?"
    type: 0
    choices:
    - "\u0E20.\u0E07.\u0E14. 1"
    - "\u0E20.\u0E07.\u0E14. 50"
    - "\u0E20.\u0E07.\u0E14. 91"
    - "\u0E20.\u0E07.\u0E14. 90"
    correctChoiceIndex: 3
    correctStringAnswer: 
  - questionText: "\u0E2B\u0E36! \u0E40\u0E08\u0E49\u0E32\u0E17\u0E33\u0E07\u0E32\u0E19\u0E1B\u0E23\u0E30\u0E08\u0E33\u0E44\u0E14\u0E49\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27
      \u0E41\u0E15\u0E48\u0E14\u0E31\u0E19\u0E41\u0E2D\u0E1A\u0E02\u0E32\u0E22\u0E02\u0E2D\u0E07\u0E2D\u0E2D\u0E19\u0E44\u0E25\u0E19\u0E4C\u0E19\u0E34\u0E14\u0E2B\u0E19\u0E48\u0E2D\u0E22\u2026
      \u0E40\u0E08\u0E49\u0E32\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49\u0E41\u0E1A\u0E1A\u0E1F\u0E2D\u0E23\u0E4C\u0E21\u0E2D\u0E30\u0E44\u0E23\u0E22\u0E37\u0E48\u0E19\u0E20\u0E32\u0E29\u0E35!?"
    type: 0
    choices:
    - "\u0E20.\u0E07.\u0E14. 91"
    - "\u0E20.\u0E07.\u0E14. 90"
    - "\u0E43\u0E0A\u0E49\u0E2D\u0E31\u0E19\u0E44\u0E2B\u0E19\u0E01\u0E47\u0E44\u0E14\u0E49"
    - "\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E22\u0E37\u0E48\u0E19"
    correctChoiceIndex: 1
    correctStringAnswer: 
  - questionText: "\u0E16\u0E49\u0E32\u0E40\u0E08\u0E49\u0E32\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E43\u0E19\u0E1B\u0E35
      2023 \u0E41\u0E15\u0E48\u0E25\u0E37\u0E21\u0E22\u0E37\u0E48\u0E19\u2026\n\u0E1B\u0E35\u0E1B\u0E01\u0E15\u0E34\u0E17\u0E35\u0E48\u0E04\u0E27\u0E23\u0E22\u0E37\u0E48\u0E19\u0E04\u0E37\u0E2D\u0E1B\u0E35\u0E2D\u0E30\u0E44\u0E23!?"
    type: 1
    choices: []
    correctChoiceIndex: 0
    correctStringAnswer: 2024
  - questionText: "\u0E07\u0E31\u0E49\u0E19\u0E21\u0E32\u0E27\u0E31\u0E14\u0E01\u0E31\u0E19\u0E17\u0E35\u0E48\u0E15\u0E31\u0E27\u0E40\u0E08\u0E49\u0E32\u0E40\u0E2D\u0E07!
      \u0E40\u0E08\u0E49\u0E32\u0E04\u0E37\u0E2D '\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19'
      \u0E1C\u0E39\u0E49\u0E21\u0E35\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E17\u0E32\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27...
      \u0E08\u0E07\u0E2B\u0E22\u0E34\u0E1A\u0E22\u0E37\u0E48\u0E19\u0E04\u0E31\u0E21\u0E20\u0E35\u0E23\u0E4C\u0E28\u0E31\u0E01\u0E14\u0E34\u0E4C\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C\u0E40\u0E25\u0E48\u0E21\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22\u0E2D\u0E2D\u0E01\u0E21\u0E32\u0E1B\u0E34\u0E14\u0E1C\u0E19\u0E36\u0E01\u0E02\u0E49\u0E32\u0E0B\u0E30! 
      \u0E0A\u0E37\u0E48\u0E2D\u0E22\u0E48\u0E2D\u0E02\u0E2D\u0E07\u0E41\u0E1A\u0E1A\u0E41\u0E2A\u0E14\u0E07\u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E20\u0E32\u0E29\u0E35
      \u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E1C\u0E39\u0E49\u0E21\u0E35\u0E40\u0E07\u0E34\u0E19\u0E44\u0E14\u0E49\u0E21\u0E32\u0E15\u0E23\u0E32
